# Streamlit Community Cloud 배포 시 앱 설정 > Secrets 에 이 내용을 (실제 값으로 채워)
# 붙여넣으면 된다. 로컬에서는 .env 를 그대로 쓰므로 이 파일은 필요 없다.
#
# 실제 값을 채운 secrets.toml 은 .gitignore 에 이미 등록돼 있어 절대 커밋되지 않는다.

ECOS_API_KEY = "발급받은 한국은행 ECOS API 키"
FRED_API_KEY = "발급받은 세인트루이스 연은 FRED API 키"

# "종목 분석" 탭(투자의견 자동 생성, 웹 검색 포함)용 — platform.openai.com 에서 발급.
# 비워두면 그 탭에 "설정 필요" 안내만 뜨고 나머지 탭은 정상 동작한다.
# 종목 하나당 웹 검색을 여러 번 쓰는 유료 호출이라 같은 종목명은 6시간 캐시된다
# (app.py STOCK_OPINION_TTL_SEC).
OPENAI_API_KEY = "발급받은 OpenAI API 키"

# 보유 종목 PER(EPS 기준)과 "종목 상세" 패널(매출액/영업이익)을 DART 전자공시에서
# 실시간으로 자동 조회하는 데 쓴다 — opendart.fss.or.kr 에서 무료로 발급(승인까지
# 즉시~반나절). 비워두면 PER은 pykrx 자체 PER로 대체되고, 종목 상세 패널은
# "설정 필요" 안내만 뜬다. 재무제표는 분기/연 단위로만 바뀌므로 하루 캐시된다
# (app.py DART_TTL_SEC).
OPENDART_API_KEY = "발급받은 OpenDART API 키"

# 대시보드에 보유 종목·평가손익이 보이므로 공개 URL을 그대로 두지 말고 비밀번호를 건다.
# 비워두면(값을 아예 안 넣으면) 비밀번호 없이 열린다.
DASHBOARD_PASSWORD = "원하는 비밀번호"

# 보유 종목 — portfolio.csv 와 같은 내용을 여기 TOML 배열로 넣는다.
# 저장소가 Public이라 portfolio.csv(실제 수량/평단가)는 커밋하지 않고 여기 Secrets에만 둔다.
# ticker 는 6자리 KRX 종목코드(따옴표로 감싸 앞자리 0 유지), 현금성 자산은 ticker="CASH"로
# 두고 quantity 에 원화 금액, avg_price 에 1을 넣는다.
# target_price(목표가)·stop_price(손절가)는 선택 항목 — "리스크 지표" 패널에서 현재가와
# 비교해 보여준다. 필요 없는 종목은 아예 줄을 빼도 된다(비우면 "-"로 표시됨).
[[portfolio]]
name = "예시종목"
ticker = "005930"
quantity = 10
avg_price = 70000
target_price = 85000
stop_price = 62000

[[portfolio]]
name = "CMA RP"
ticker = "CASH"
quantity = 1000000
avg_price = 1
